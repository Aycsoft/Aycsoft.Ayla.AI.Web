# CrossCart.AI API 根地址。生产同源部署时保留 /api。
VITE_API_BASE_URL=/api
# 本地开发 AI 代理目标；统一使用 localhost。请勿在此配置任何 Provider API Key。
VITE_DEV_PROXY_TARGET=http://localhost:5088
# AI Web 的物理部署目录；生产反向代理使用 /ai-workbench/。
VITE_APP_BASE_PATH=/ai-workbench/
# ERP 登录后的 AI 授权入口。它会先走 ERP 原生登录，再签发一次性票据返回 AI Web。
VITE_SSO_LOGIN_URL=/#/ai/sso/authorize
VITE_PORTAL_ORIGIN=http://localhost:4000
VITE_DEFAULT_AI_LOGO_URL=http://localhost:4000/src/assets/images/ayla-logo-user.png
VITE_PORT=5176
VITE_PREVIEW_PORT=4176
